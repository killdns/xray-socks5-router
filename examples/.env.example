# Build and image metadata
IMAGE=killdns/xray-socks5-router
VERSION=0.2.0
XRAY_CONFIG_FILE=./config/config.json
ROUTING_MODE=tproxy

# Example-only TEST-NET addresses. Replace every value for your deployment.
INBOUND_NETWORK=transit_in
INBOUND_ADDRESS=192.0.2.2
INBOUND_GATEWAY=
RETURN_CIDRS=

OUTBOUND_NETWORK=underlay_out
OUTBOUND_ADDRESS=198.51.100.2
OUTBOUND_GATEWAY=

# Interfaces and OUTBOUND_GATEWAY are detected automatically. Set
# INBOUND_GATEWAY only when RETURN_CIDRS contains networks behind another router.

# Leave empty when clients route directly to INBOUND_ADDRESS.
SOCKS_BIND=0.0.0.0
SOCKS_UDP_ADVERTISE_IP=

# Never commit the production Xray config or SOCKS credentials.
# The compose example expects examples/config/config.json.
